# TriAgent environment variables (copy to backend/.env)

# OpenWeatherMap: live weather for the Execution Agent (free tier is enough)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional cloud backbones; not needed for the vLLM runs of the paper
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Twilio SMS: optional, simulation mode if not set
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
